# DevPulse production environment. Copy to .env.prod and fill in values:
#   cp .env.prod.example .env.prod
# Or generate it (random Postgres password) with:
#   ./scripts/new-prod-env.sh http://YOUR_VPS_IP:5000 https://YOUR_APP.vercel.app
#
# Deploy targets:
#   1 GiB VPS (recommended): API + Postgres on VPS, dashboard on Vercel:
#     docker compose --env-file .env.prod -f docker-compose.yml -f docker-compose.vps.yml up -d --build
#   Full stack on VPS (needs 2GB+ RAM, builds Next.js locally):
#     docker compose --env-file .env.prod -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#
# NEVER commit .env.prod. It holds the database password.

# Application
APP_ENV=production
API_PORT=8080
HOST_API_PORT=5000
HOST_DASHBOARD_PORT=3000

# PostgreSQL (container on the VPS; port is NOT published in production)
POSTGRES_DB=devpulse
POSTGRES_USER=devpulse
POSTGRES_PASSWORD=CHANGE_ME__run_scripts_new_prod_env_sh

# Database (API reaches Postgres over the compose network)
DATABASE_URL=postgres://devpulse:CHANGE_ME__run_scripts_new_prod_env_sh@postgres:5432/devpulse?sslmode=disable

# Public origins (browser-facing). The dashboard reads these at build time
# on Vercel, so changing them means redeploying the dashboard there.
# 1 GiB setup: PUBLIC_API_URL=http://YOUR_VPS_IP:5000, dashboard lives on
# Vercel (https://YOUR_APP.vercel.app).
PUBLIC_API_URL=http://YOUR_VPS_IP:5000
PUBLIC_TRACKER_URL=

# CORS: dashboard origin(s) allowed to call the API. Required in
# production; the API refuses to start without it. For Vercel this is your
# Vercel URL (comma-separated if you also keep a local dashboard).
# Example: CORS_ALLOWED_ORIGINS=https://YOUR_APP.vercel.app
CORS_ALLOWED_ORIGINS=https://YOUR_APP.vercel.app

# Prebuilt images for low-memory VPS deployments. Set these to the exact
# commit tag published by the GitHub Actions workflow, then include
# docker-compose.registry.yml when starting the stack.
# API_IMAGE=ghcr.io/YOUR_GITHUB_OWNER/devpulse-api:COMMIT_SHA
# DASHBOARD_IMAGE=ghcr.io/YOUR_GITHUB_OWNER/devpulse-dashboard:COMMIT_SHA

# Analytics
RETENTION_INTERVAL_MINUTES=60

# GeoIP (optional): place GeoLite2-City.mmdb in ./geoip/ on the host to
# enable country/region enrichment. Leave empty to report Unknown.
GEOIP_DB_PATH=
