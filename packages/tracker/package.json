{
  "name": "@devpulse/tracker",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "files": ["dist"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/index.ts --bundle --minify --format=iife --platform=browser --target=es2018 --global-name=DevPulse --outfile=dist/analytics.js && node scripts/build-versioned.mjs",
    "size": "node scripts/check-size.mjs",
    "test": "esbuild test/tracker.test.ts --bundle --platform=node --format=cjs --target=node18 --outfile=dist-test/tracker.test.cjs && node --test dist-test/tracker.test.cjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.10",
    "typescript": "^5.9.3"
  }
}
