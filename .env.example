# Application
APP_ENV=development
API_PORT=8080
HOST_API_PORT=5000

# Session cookie: defaults to Secure + __Host- name when
# APP_ENV=production (set SESSION_COOKIE_SECURE=true to force it on
# plain-HTTP development behind a TLS proxy, or false to force it off).
# SESSION_COOKIE_SECURE=

# Email (verification + password resets) goes through Resend
# (https://resend.com). Unset means the dev log sender: links are
# printed to the API log instead of being emailed — fine locally,
# production refuses to boot without a key. EMAIL_FROM must be an
# address Resend is allowed to send from; APP_URL is the origin links
# in emails point back to.
# RESEND_API_KEY=re_...
# EMAIL_FROM=DevPulse <onboarding@resend.dev>
# APP_URL=http://localhost:3000

# Optional social login. Each provider needs both halves of its
# credential pair or it stays off. In the provider's app config, the
# callback URL is APP_URL + /api/v1/auth/oauth/<provider>/callback
# (e.g. http://localhost:3000/api/v1/auth/oauth/github/callback).
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# PostgreSQL
POSTGRES_DB=devpulse
POSTGRES_USER=devpulse
POSTGRES_PASSWORD=devpulse_dev_password
POSTGRES_PORT=5433

# Database
DATABASE_URL=postgres://devpulse:devpulse_dev_password@postgres:5432/devpulse?sslmode=disable

# Dashboard
NEXT_PUBLIC_API_URL=http://localhost:5000

# Analytics
DEFAULT_RETENTION_DAYS=90
SESSION_TIMEOUT_MINUTES=30
REALTIME_WINDOW_MINUTES=5
RETENTION_INTERVAL_MINUTES=60

# CORS: comma-separated dashboard/tracker origins allowed to call the API
# (e.g. https://app.example.com,https://example.com). Empty means open
# mode for local development; always set this in production.
CORS_ALLOWED_ORIGINS=

# GeoIP (optional): path to a MaxMind City database inside the API
# container. Leave empty to disable geography (countries show Unknown).
# Place GeoLite2-City.mmdb in ./geoip/ and use /geoip/GeoLite2-City.mmdb.
GEOIP_DB_PATH=

# Tracker bundle directory served by the API at /analytics.js and
# /analytics-<version>.js (immutable cache). Docker image bakes the
# production bundle into /tracker-dist; local dev can point at
# ./packages/tracker/dist after `pnpm --filter @devpulse/tracker build`.
TRACKER_DIR=
NEXT_PUBLIC_TRACKER_URL=